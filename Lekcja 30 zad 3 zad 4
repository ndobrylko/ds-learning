        "Zadanie 4 -- Konwolucja 1x1 bottleneck\n",
        "Zbuduj model z bottleneck (Conv2D 1x1 do redukcji kanalow) i bez. Porownaj parametry.<br>\n",
        "Wymagania:<br>\n",
        "Wejscie: (14, 14, 128)<br>\n",
        "Bez bottleneck: Conv2D(256, 3x3)<br>\n",
        "Z bottleneck: Conv2D(32, 1x1) -- Conv2D(32, 3x3) -- Conv2D(256, 1x1)<br>\n",
        "Porownaj parametry<br>"
      ],
      "metadata": {
        "id": "R763Es1er0Hs"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import Input, Conv2D\n",
        "\n",
        "# model bez bottleneck\n",
        "model_plain = Sequential([\n",
        "    Input(shape=(14, 14, 128)),\n",
        "    Conv2D(256, (3,3), padding='same')\n",
        "])\n",
        "\n",
        "# model z bottleneck\n",
        "model_bottleneck = Sequential([\n",
        "    Input(shape=(14, 14, 128)),\n",
        "    Conv2D(32, (1,1), padding='same'),\n",
        "    Conv2D(32, (3,3), padding='same'),\n",
        "    Conv2D(256, (1,1), padding='same')\n",
        "])\n",
        "\n",
        "print(\"Bez bottleneck:\", model_plain.count_params())\n",
        "print(\"Z bottleneck:\", model_bottleneck.count_params())"
      ],
