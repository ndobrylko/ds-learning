    "liczby = [-5, 3, -2, 8, 0, -1, 7, 4, -9, 6]\n",
    "\n",
    "dodatnie = filter(lambda x: x > 0, liczby)\n",
    "podwojone = map(lambda x: x * 2, dodatnie)\n",
    "wynik = list(podwojone)\n",
    "print(\"Lista:\", wynik)"
